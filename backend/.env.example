# Copy to .env and fill in real values. Never commit .env.
# On Render, set these in the dashboard instead (Environment tab).

# Supabase -> Project Settings -> API
SUPABASE_URL=
# SECRET: the service_role / secret key. Server-side only; bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
# Used to verify legacy HS256 tokens. Projects on asymmetric (ES256/RS256) signing keys
# verify via JWKS instead; still set it so either token type works.
SUPABASE_JWT_SECRET=

# Google AI Studio API key (embeddings, summaries, chat, video)
GEMINI_API_KEY=

# CORS: comma-separated browser origins allowed to call this API.
# Production: your Vercel URL, e.g. https://my-app.vercel.app (no trailing slash needed).
FRONTEND_ORIGIN=http://localhost:3000
# Optional: regex for extra origins such as Vercel preview deployments.
# FRONTEND_ORIGIN_REGEX=https://my-app-.*\.vercel\.app
# Allow http://localhost / 127.0.0.1 on any port. Set to false in production.
ALLOW_LOCALHOST_ORIGINS=true

# Optional model overrides (defaults are set in app/config.py)
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# GEMINI_VIDEO_MODEL=gemini-3.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
