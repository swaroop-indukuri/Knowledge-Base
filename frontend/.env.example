# Copy to .env.local and fill in. Both Supabase values are safe to expose to the
# browser (Supabase Dashboard -> Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the FastAPI backend: http://localhost:8000 locally; your Render URL in
# production (e.g. https://knowledge-base-api.onrender.com). Inlined at build time, so
# redeploy after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8000
